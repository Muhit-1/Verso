# ---- .NET ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.binlog

# ---- NuGet ----
*.nupkg
*.snupkg
packages/
!packages/build/

# ---- Rider / VS Code ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
