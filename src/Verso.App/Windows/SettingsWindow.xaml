<Window x:Class="Verso.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verso settings"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B1416"
        Foreground="#E6EEEC"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#C9A96A" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#7C9198" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0F1D20" />
            <Setter Property="Foreground" Value="#E6EEEC" />
            <Setter Property="BorderBrush" Value="#2A3A3D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EEEC" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0F1D20" />
            <Setter Property="Foreground" Value="#E6EEEC" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">

        <TextBlock Text="Verso" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Everything here also lives in the tray menu — this is the same settings, laid out." Style="{StaticResource Hint}" />

        <TextBlock Text="DESK" Style="{StaticResource Section}" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="PauseButton" Content="Hide the desk" Click="OnTogglePause" />
            <Button x:Name="ReloadButton" Content="Reload" Click="OnReload" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" />

        <TextBlock Text="BACKGROUND" Style="{StaticResource Section}" />
        <TextBlock x:Name="BackgroundText" Style="{StaticResource Hint}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
            <Button Content="Choose file…" Click="OnPickBackground" />
            <Button Content="Clear" Click="OnClearBackground" />
        </StackPanel>
        <TextBlock Text="Video and interactive backgrounds only render where the desk is the full wallpaper, not in the panels-only overlay mode most Windows 11 builds use — see docs/plan.md, Phase 3."
                   Style="{StaticResource Hint}" />

        <TextBlock Text="DESKTOP" Style="{StaticResource Section}" />
        <CheckBox x:Name="HideTaskbarCheck" Content="Hide taskbar" Checked="OnHideTaskbarChanged" Unchecked="OnHideTaskbarChanged" />
        <CheckBox x:Name="HideIconsCheck" Content="Hide desktop icons" Checked="OnHideIconsChanged" Unchecked="OnHideIconsChanged" />

        <TextBlock Text="THEME" Style="{StaticResource Section}" />
        <ComboBox x:Name="ThemeCombo" DisplayMemberPath="Name" SelectionChanged="OnThemeChanged" />

        <Button Content="Close" HorizontalAlignment="Right" Margin="0,22,0,0" Click="OnClose" />

    </StackPanel>
</Window>
