<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Every Win32 call Verso makes, in one place.

    P/Invoke signatures are generated by CsWin32 from the list in
    NativeMethods.txt rather than written by hand: the marshalling on
    SendMessageTimeout and the hook callbacks is exactly the kind of thing
    that is silently wrong for months when you type it yourself.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Verso.Interop</RootNamespace>
    <AssemblyName>Verso.Interop</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verso.Core\Verso.Core.csproj" />
  </ItemGroup>

</Project>
